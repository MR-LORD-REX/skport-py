      "text": {
       "inlineElements": [
        {
         "kind": "text",
         "text": {
          "text": "「ここからここまで……わあ、こんなに遠くまで行って、たくさん悪い奴をやっつけたんだ。」"
         }
        }
       ],
       "kind": "body"
      }
     },
     "B1ccpuJ8I9ml": {
      "id": "B1ccpuJ8I9ml",
      "parentId": "document-id",
      "align": "left",
      "kind": "text",
      "text": {
       "inlineElements": [
        {
         "kind": "text",
         "text": {
          "text": "「簡単だよ。凍らせて、燃やして、ドーン！バーン！ドカーン！それでおしまい！おいらずーっとこうやってきたから、らくしょーだよ。」"
         }
        }
       ],
       "kind": "body"
      }
     },
     "GhlaPFm4F8lF": {
